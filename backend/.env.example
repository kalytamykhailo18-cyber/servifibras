# =============================================================================
# Servifibras — env vars template (C4 del documento del 10-07)
# =============================================================================
# Marcos 2026-07-13: este archivo viaja con el repo como referencia. NO
# incluye secretos reales — sólo la lista de variables que la app espera
# y para qué sirven. El .env real de producción sigue viviendo en el
# servidor (mode 640, chown servifibras:servifibras — ver deploy.sh).
#
# Categorías cubiertas: Postgres, JWT, backups, canales (WA / ML / TN /
# FB / IG), Claude/API keys, throttling, encryption, features flags,
# knobs de agente (Bloque B/E). Vars menos usadas van con el default
# comentado al lado.

# --- Base de datos (obligatorias) --------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/servifibras
# Pool más chico que default de Prisma (5) para no saturar el server
# en dev; producción suele quedar en 3 (fine porque los queries son cortos).
# PRISMA_CONNECTION_LIMIT=3

# --- Seguridad ----------------------------------------------------------------
# JWT_SECRET (obligatoria, 32+ chars). La app se REHUSA a arrancar si
# está vacía, es el default de dev, o tiene menos de 32 chars.
# Generá con: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32-caracteres-minimo
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_SEC=604800

# ALLOW_DEV_JWT_SECRET=1 salta el guard de longitud (sólo para dev/tests).
# NUNCA setear en producción.
# ALLOW_DEV_JWT_SECRET=0

# Encriptación de mensajes a nivel columna. Si no está seteada, los
# mensajes se guardan en plaintext (dev). En prod SIEMPRE se activa.
# Generá con: openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=CHANGE-ME-openssl-rand-hex-32

# Lockout (Marcos 2026-06-08, security item 9)
ACCOUNT_LOCKOUT_ENABLED=true
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_WINDOW_MIN=15
ACCOUNT_LOCKOUT_DURATION_MIN=15

# --- Claude / AI --------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-CHANGE-ME
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS_ASK=2048
CLAUDE_BUDGET_HARD_STOP=999999

# Bloque B — memoria de correcciones (B1): cupo propio, default 8.
# CONVERSATION_STYLE_MAX_CORRECTIONS=8
# CONVERSATION_STYLE_MAX_STYLE_EXAMPLES=16
# CONVERSATION_STYLE_MAX_EXAMPLES=8

# Modo cerrado (constrained reply) y auto-envío.
ML_CONSTRAINED_REPLY_ENABLED=false
ML_CONSTRAINED_MIN_CURATED=3
ML_CONSTRAINED_AUTOSEND_THRESHOLD=8.5
ML_AUTO_SEND_DISABLED=true

# A3 — modo revisión en WhatsApp. Cuando está en true, la IA responde
# pero deja el mensaje como borrador (metadata.pendingReview=true); el
# operador aprueba desde el CRM.
WHATSAPP_AUTO_SEND_DISABLED=false

# Bloque E — cost knobs
CONVERSATION_HISTORY_COMPRESSION_ENABLED=true
CONVERSATION_HISTORY_COMPRESS_AFTER=15
# ML_BATCH_QUEUE_ENABLED=true
# ML_BATCH_QUEUE_DISPATCH_CRON=*/1 * * * *

# --- WhatsApp -----------------------------------------------------------------
# Meta Cloud API (canal oficial — bloqueado en Meta business verification
# como blocker cliente-side desde 2026-06 según todo.md).
WHATSAPP_ACCESS_TOKEN=CHANGE-ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE-ME
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE-ME-openssl-rand-hex-16
WHATSAPP_APP_SECRET=CHANGE-ME

# WhatsApp QR (Baileys) — canal alternativo cuando Meta está bloqueado.
WHATSAPP_QR_ENABLED=true
WHATSAPP_DEFAULT_AI_PAUSED=true

# --- Mercado Libre ------------------------------------------------------------
MERCADOLIBRE_CLIENT_ID=CHANGE-ME
MERCADOLIBRE_CLIENT_SECRET=CHANGE-ME
MERCADOLIBRE_REDIRECT_URI=https://api.tudominio.com/mercadolibre/callback
ML_STORE_URL=https://www.mercadolibre.com.ar/tienda/servifibras

# --- TiendaNube ---------------------------------------------------------------
TIENDANUBE_STORE_ID=CHANGE-ME
TIENDANUBE_ACCESS_TOKEN=CHANGE-ME
TIENDANUBE_WEBHOOK_HMAC_STRICT=true

# --- Meta (FB + IG) — bloqueado hasta que salga la verification --------------
FACEBOOK_APP_SECRET=CHANGE-ME
FACEBOOK_PAGE_ID=CHANGE-ME
FACEBOOK_ACCESS_TOKEN=CHANGE-ME
INSTAGRAM_ACCOUNT_ID=CHANGE-ME
INSTAGRAM_ACCESS_TOKEN=CHANGE-ME

# --- Backups (Marcos 2026-06-30, backup remoto) ------------------------------
BACKUP_ENCRYPTION_KEY=CHANGE-ME-openssl-rand-hex-32
BACKUP_DIR=/srv/servifibras-backups
# BACKUP_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
BACKUP_ALERT_PHONE=
BACKUP_STALE_AFTER_HOURS=30

# --- Throttling ---------------------------------------------------------------
# THROTTLE_WEBHOOK_LIMIT=200
# THROTTLE_TTL_MS=60000

# --- Bluelytics / MEP -------------------------------------------------------
BLUELYTICS_API_URL=https://api.bluelytics.com.ar/v2/latest

# --- E2E / tests --------------------------------------------------------------
# SERVIFIBRAS_E2E=1 — usado por run-all.sh como prefixed
# WHATSAPP_QR_ENABLED=false — obligatorio en tests que abren AppModule
#                              para no armar sesión Baileys paralela
#                              (ver [[feedback_e2e_seed_bricks_prod_users]]
#                              en las notas de dev).

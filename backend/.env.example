# Database
DATABASE_URL="postgresql://servifibras_user:servifibras_2024_secure@localhost:5432/servifibras_db"

# Server
PORT=3001

# Authentication - JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AI - Claude API
CLAUDE_API_KEY=sk-ant-your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_FALLBACK_MODEL=claude-haiku-4-20250514

# Pricing - Exchange Rate
BLUELYTICS_API_URL=https://api.bluelytics.com.ar/v2/latest
EXCHANGE_RATE_CACHE_MINUTES=15

# Pricing - TiendaNube (get from TiendaNube admin panel)
TIENDANUBE_API_URL=https://api.tiendanube.com/v1
TIENDANUBE_STORE_ID=your-store-id-here
TIENDANUBE_ACCESS_TOKEN=your-access-token-here

# Pricing - Discounts (percentages)
VOLUME_DISCOUNT_20L=5
VOLUME_DISCOUNT_100L=10
VOLUME_DISCOUNT_200L=15
MAYORISTA_EXTRA_DISCOUNT=10

# WhatsApp - Meta Cloud API (get from Meta Business Suite)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token-here
WHATSAPP_APP_SECRET=your-app-secret-here

# Facebook & Instagram - Meta Graph API (get from Meta Business Suite)
FACEBOOK_API_URL=https://graph.facebook.com/v18.0
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token-here
FACEBOOK_PAGE_ID=your-facebook-page-id-here
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id-here
SOCIAL_WEBHOOK_VERIFY_TOKEN=your-social-webhook-verify-token-here
FACEBOOK_APP_SECRET=your-facebook-app-secret-here

# MercadoLibre - API (get from MercadoLibre Developers)
MERCADOLIBRE_API_URL=https://api.mercadolibre.com
MERCADOLIBRE_ACCESS_TOKEN=your-ml-access-token-here
MERCADOLIBRE_USER_ID=your-ml-user-id-here
MERCADOLIBRE_APP_ID=your-ml-app-id-here

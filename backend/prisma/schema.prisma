generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model configurations {
  id          String            @id
  type        ConfigurationType
  key         String            @unique
  value       Json
  description String?
  isActive    Boolean           @default(true)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime

  @@index([isActive])
  @@index([key])
  @@index([type])
}

model contacts {
  id            String          @id
  name          String?
  phone         String?         @unique
  email         String?
  type          ContactType     @default(MINORISTA)
  channel       Channel?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  conversations conversations[]
  leads         leads[]
  orders        orders[]
}

model conversations {
  id            String             @id
  contactId     String
  channel       Channel
  status        ConversationStatus @default(ACTIVE)
  assignedTo    String?
  lastMessage   String?
  lastMessageAt DateTime?
  isUnread      Boolean            @default(true)
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime
  users         users?             @relation(fields: [assignedTo], references: [id])
  contacts      contacts           @relation(fields: [contactId], references: [id])
  messages      messages[]

  @@index([assignedTo])
  @@index([channel])
  @@index([contactId])
  @@index([status])
}

model knowledge_base {
  id          String   @id
  category    String
  subcategory String?
  title       String
  content     String
  active      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([active])
  @@index([category])
}

model leads {
  id              String     @id
  contactId       String
  assignedTo      String?
  status          LeadStatus @default(NEW)
  source          Channel
  productInterest String?
  estimatedValue  Float?
  notes           String?
  wonAmount       Float?
  lostReason      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  users           users?     @relation(fields: [assignedTo], references: [id])
  contacts        contacts   @relation(fields: [contactId], references: [id])

  @@index([assignedTo])
  @@index([contactId])
  @@index([status])
}

model messages {
  id             String        @id
  conversationId String
  sender         MessageSender
  content        String
  contentType    ContentType   @default(TEXT)
  isFromAI       Boolean       @default(false)
  metadata       Json?
  timestamp      DateTime      @default(now())
  conversations  conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
}

model orders {
  id             String      @id
  orderNumber    String      @unique
  contactId      String
  amount         Float
  currency       String      @default("USD")
  products       Json
  status         OrderStatus @default(CONFIRMED)
  trackingNumber String?
  carrier        String?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  contacts       contacts    @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([orderNumber])
  @@index([status])
}

model users {
  id            String          @id
  email         String          @unique
  username      String          @unique
  password      String
  name          String
  role          UserRole
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  conversations conversations[]
  leads         leads[]
}

enum Channel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  MERCADOLIBRE
  TIENDANUBE_WEBCHAT
}

enum ConfigurationType {
  CHANNEL
  AI
  PRICING
  SYSTEM
}

enum ContactType {
  MINORISTA
  MAYORISTA
  EMPRENDEDOR
  INDUSTRIAL
}

enum ContentType {
  TEXT
  IMAGE
  VOICE
  VIDEO
  DOCUMENT
  LOCATION
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  WAITING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

enum MessageSender {
  CUSTOMER
  AI
  BRENDA
  FRANCO
  ALDO
  ADMIN
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum UserRole {
  ADMIN
  ATENCION
  VENTAS
  LOGISTICA
}

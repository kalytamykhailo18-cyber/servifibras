// Servifibras AI Platform - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Team Members (Brenda, Franco, Aldo, Admin)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  name      String
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  leads         Lead[]

  @@map("users")
}

enum UserRole {
  ADMIN
  ATENCION
  VENTAS
  LOGISTICA
}

// Customer Information
model Contact {
  id        String      @id @default(uuid())
  name      String?
  phone     String?     @unique
  email     String?
  type      ContactType @default(MINORISTA)
  channel   Channel?
  metadata  Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  conversations Conversation[]
  leads         Lead[]
  orders        Order[]

  @@map("contacts")
}

enum ContactType {
  MINORISTA
  MAYORISTA
  EMPRENDEDOR
  INDUSTRIAL
}

// Chat Sessions
model Conversation {
  id            String             @id @default(uuid())
  contactId     String
  channel       Channel
  status        ConversationStatus @default(ACTIVE)
  assignedTo    String?
  lastMessage   String?
  lastMessageAt DateTime?
  isUnread      Boolean            @default(true)
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  contact  Contact   @relation(fields: [contactId], references: [id])
  assigned User?     @relation(fields: [assignedTo], references: [id])
  messages Message[]

  @@index([contactId])
  @@index([assignedTo])
  @@index([channel])
  @@index([status])
  @@map("conversations")
}

enum Channel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  MERCADOLIBRE
  TIENDANUBE_WEBCHAT
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  WAITING
}

// Individual Messages
model Message {
  id             String        @id @default(uuid())
  conversationId String
  sender         MessageSender
  content        String
  contentType    ContentType   @default(TEXT)
  isFromAI       Boolean       @default(false)
  metadata       Json?
  timestamp      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
  @@map("messages")
}

enum MessageSender {
  CUSTOMER
  AI
  BRENDA
  FRANCO
  ALDO
  ADMIN
}

enum ContentType {
  TEXT
  IMAGE
  VOICE
  VIDEO
  DOCUMENT
  LOCATION
}

// Wholesale Opportunities
model Lead {
  id              String     @id @default(uuid())
  contactId       String
  assignedTo      String?
  status          LeadStatus @default(NEW)
  source          Channel
  productInterest String?
  estimatedValue  Float?
  notes           String?
  wonAmount       Float?
  lostReason      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  contact  Contact @relation(fields: [contactId], references: [id])
  assigned User?   @relation(fields: [assignedTo], references: [id])

  @@index([contactId])
  @@index([assignedTo])
  @@index([status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

// Confirmed Sales
model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  contactId      String
  amount         Float
  currency       String      @default("USD")
  products       Json
  status         OrderStatus @default(CONFIRMED)
  trackingNumber String?
  carrier        String?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contact Contact @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

// Product Knowledge Base
model KnowledgeBase {
  id          String   @id @default(uuid())
  category    String
  subcategory String?
  title       String
  content     String
  active      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@map("knowledge_base")
}

// System Configuration (channels, AI, pricing, etc.)
model Configuration {
  id          String            @id @default(uuid())
  type        ConfigurationType
  key         String            @unique
  value       Json
  description String?
  isActive    Boolean           @default(true)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([type])
  @@index([key])
  @@index([isActive])
  @@map("configurations")
}

enum ConfigurationType {
  CHANNEL
  AI
  PRICING
  SYSTEM
}
